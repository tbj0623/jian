         0.6.0 加了 today 与 note 两枚（五枚是系统上限）。 -->
    <string name="shortcut_yi_short">过一件衣</string>
    <string name="shortcut_yi_long">买之前，先问柜子</string>
    <string name="shortcut_wei_short">排一桌菜</string>
    <string name="shortcut_wei_long">这桌人的口味，叠成一张笺</string>
    <string name="shortcut_yan_short">捞一段话</string>
    <string name="shortcut_yan_long">说过的话，落成一张笺</string>
    <string name="shortcut_today_short">看今天</string>
    <string name="shortcut_today_long">今天要穿、要吃、要记的三件事</string>
    <string name="shortcut_note_short">记一笔</string>
    <string name="shortcut_note_long">先把话放进去，待会儿再捞成笺</string>
